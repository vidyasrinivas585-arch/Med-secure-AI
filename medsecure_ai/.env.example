# MedSecure AI - Environment Configuration
# Copy this file to .env and fill in your values

# MongoDB Atlas Connection String
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://your_username:your_password@cluster0.xxxxx.mongodb.net/medsecure_ai?retryWrites=true&w=majority

# Flask Secret Key (change this to a random string in production)
SECRET_KEY=medsecure_ai_secret_key_change_in_production

# Flask Environment
FLASK_ENV=development
FLASK_DEBUG=True

# Upload folder
UPLOAD_FOLDER=static/uploads

# Model path
MODEL_PATH=trained_model/medicine_classifier.h5
